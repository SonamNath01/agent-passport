DATABASE_URL="postgresql://passport:passport@localhost:5432/agent_passport?schema=public"
ISSUER_PORT=4001
PASSPORT_PORT=4000
AGENT_PORT=4002
ISSUER_URL="http://localhost:4001"
PASSPORT_URL="http://localhost:4000"
# Test-mode credentials from your Razorpay dashboard — only apps/passport reads these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_TIMEOUT_MS=8000
# scripted (default) or llm — see apps/agent/src/brainSelector.ts
AGENT_BRAIN=scripted
# Only apps/agent reads this (apps/passport and apps/issuer never see it).
ANTHROPIC_API_KEY=
