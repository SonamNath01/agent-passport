ISSUER_URL="http://localhost:4001"
PASSPORT_URL="http://localhost:4000"
AGENT_PORT=4002
# scripted (default) or llm — see apps/agent/src/brainSelector.ts
AGENT_BRAIN=scripted
# Only read when AGENT_BRAIN=llm. Groq is an inference provider
# (console.groq.com), not xAI's Grok — an OpenAI-compatible endpoint, see
# apps/agent/src/llmProvider.ts.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
